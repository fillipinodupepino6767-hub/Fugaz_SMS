<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- These permissions are appropriate only for an app the user makes the SMS default. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <!-- Android 13+: runtime permission for incoming and deletion notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Optional: show contact names and photos instead of raw numbers. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Silence timer: restore the ringer sound (normal permission). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Silence timer: also lift Do Not Disturb on restore (user grants in system settings). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Ringer watch: foreground service that detects external silence changes. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34): typed FGS required; specialUse fits a user-opted ringer watchdog. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 12+: exact per-SMS delete alarms. If denied, the scheduler falls back to inexact alarms. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Android 11+: package visibility. Without this, getLaunchIntentForPackage()
         cannot see Google Messages and wrongly reports it as not installed. -->
    <queries>
        <package android:name="com.google.android.apps.messaging" />
        <!-- Balance screen: open the carrier SIM Toolkit menu (operator services). -->
        <package android:name="com.android.stk" />
        <package android:name="com.android.stk2" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ConversationActivity"
            android:exported="true" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".SimSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".SilenceTimerActivity"
            android:exported="false" />
        <activity
            android:name=".BalanceActivity"
            android:exported="false" />
        <activity
            android:name=".DeletedHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ArchivedActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Required for an Android SMS-role app to handle SMS/MMS compose intents. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Required for a default SMS app. -->
        <service
            android:name=".RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Android delivers SMS_DELIVER only to the user-selected default SMS app. -->
        <receiver
            android:name=".IncomingSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Declared for SMS-role eligibility. This first version intentionally does not process MMS. -->
        <receiver
            android:name=".IncomingMmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <receiver android:name=".DeleteAlarmReceiver" android:exported="false" />
        <receiver android:name=".HistoryExpiryReceiver" android:exported="false" />
        <receiver android:name=".SentSmsReceiver" android:exported="false" />
        <receiver android:name=".KeepSmsReceiver" android:exported="false" />
        <receiver android:name=".RingerRestoreReceiver" android:exported="false" />
        <receiver android:name=".RingerWatchActionReceiver" android:exported="false" />
        <service
            android:name=".RingerWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects external ringer-mode changes (Volume Styles, system silent) so the user can one-tap arm the silence timer they configured. User must enable the watch; nothing is armed automatically." />
        </service>
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Restart the ringer watch after an app update kills the service. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
